# Copia este ficheiro para ".env" (o iniciar.bat faz isto por ti).
# O .env NUNCA vai para o GitHub (está no .gitignore).
# Se a mesma linha aparecer duas vezes, conta a ÚLTIMA.

# Fornecedor da conversa e das fichas: groq, openai, anthropic ou ollama
PROVEDOR=groq
PROVEDOR_FICHA=groq
GROQ_API_KEY=coloca-aqui-a-tua-chave-do-groq

# Opcional: escolher os modelos (lista em https://console.groq.com/docs/models)
# MODELO=llama-3.3-70b-versatile
# MODELO_FICHA=openai/gpt-oss-120b

# Outros fornecedores (se quiseres trocar):
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...
